# =================================================================
# JobTracker Environment Configuration (.env)
# Copy this file to .env and replace with your secure secrets
# =================================================================

# -----------------------------------------------------------------
# Database Connection (Neon DB / PostgreSQL / Cloud DB)
# Supports Npgsql string or postgres:// URI format
# -----------------------------------------------------------------
DATABASE_URL=Host=your-neon-hostname.neon.tech; Database=neondb; Username=neondb_owner; Password=your_secure_db_password; SSL Mode=Require;

# Optional local PostgreSQL container fallback variables
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=your_secure_postgres_password_here

# -----------------------------------------------------------------
# Authentication & Security (JWT)
# Key MUST be at least 32 characters (256 bits) long
# -----------------------------------------------------------------
JWT_KEY=your_at_least_32_characters_secret_jwt_key_here_123456
JWT_ISSUER=JobTrackerAPI
JWT_AUDIENCE=JobTrackerClient

# -----------------------------------------------------------------
# Initial Admin Account (Seeded on first startup)
# -----------------------------------------------------------------
ADMIN_EMAIL=demo@jobtracker.dev
ADMIN_PASSWORD=Demo123!